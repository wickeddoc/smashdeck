# config.yaml
hue:
  bridge_ip: "192.168.1.1"
  # Rooms are read live from the bridge; only scenes need configuring.
  # Find scene IDs via the bridge API: http://<bridge_ip>/api/<user>/scenes
  scenes:
    - name: "Relax"
      group_id: 1
      scene_id: "abc123"
      icon: "scene_relax.png"   # any icon from icons/
    - name: "Focus"
      group_id: 1
      scene_id: "def456"
      icon: "scene_focus.png"

kasa:
  devices:
    - name: "Heater"
      host: "192.168.1.2"
    - name: "Fan"
      host: "192.168.1.3"

tapo:
  email: "YOUR_TAPO_EMAIL"
  password: "YOUR_TAPO_PASSWORD"
  devices:
    - name: "Lamp 1"
      host: "192.168.1.30"
    - name: "Strip 1"
      host: "192.168.1.31"

spotify:
  # No credentials needed: playback control and playlist launching go over
  # DBus/MPRIS2. Up to 5 playlists are shown on row 4 of the Spotify page.
  playlists:
    - name: "Chill"
      uri: "spotify:playlist:xxxxx"
    - name: "Work"
      uri: "spotify:playlist:yyyyy"
  # Optional: the artist's photo on the artist keys (Home and Spotify page),
  # from fanart.tv. The artist name is sent to musicbrainz.org to find its
  # ID, then fanart.tv is asked for the photo; photos are cached on disk.
  # Needs a free fanart.tv project key: https://fanart.tv/get-an-api-key/
  # artist_art:
  #   enabled: true                         # default when this section exists
  #   api_key: "your-project-key"           # required
  #   client_key: "your-personal-key"       # optional: newer photos sooner
  #   cache_dir: "~/.cache/smashdeck/artists"   # optional; this is the default

monitor:
  # Up to 2 disks, shown on keys 17-18 as "Disk <name>" (% full).
  disks:
    - name: "/"
      path: "/"
    - name: "Home"
      path: "/home"
  # net_interface: "eth0"     # optional; default = interface on the default route
  weather:
    # Sent to api.open-meteo.com (no API key). This example is Berlin.
    latitude: 52.52
    longitude: 13.41
